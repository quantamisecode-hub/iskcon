# =============================================================
# BACKEND - example environment file. COPY to ".env" and fill in
# your own local values. ".env" is never committed to Git.
# Only variables actually needed in Phase 1 are listed.
# =============================================================

# Development mode (development | test | production)
NODE_ENV=development

# Port the API listens on
PORT=5000

# MySQL connection. Template only - put YOUR local MySQL user and a
# strong password here, never in .env.example.
DATABASE_URL="mysql://USERNAME:PASSWORD@localhost:3306/DATABASE_NAME"

# Maximum HTTP request body size
REQUEST_BODY_LIMIT=100kb

# Allowed browser origin(s) for credential-bearing CORS.
# One origin, or a comma-separated list for staging/preview deployments.
CORS_ORIGIN=http://localhost:5173

# Legacy alias still accepted. CORS_ORIGIN takes precedence when both exist.
# FRONTEND_URL=http://localhost:5173

# Session cookie settings (used by authentication in Phase 2)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Session cookie lifetime in days
SESSION_EXPIRES_DAYS=7

# ---- Seed credentials (development only - replace with your own) ----
# Quote values containing # or spaces!
DEV_ADMIN_EMAIL="admin@yourname.local"
DEV_ADMIN_PASSWORD="ChooseDevAdminPass#1"
DEV_EXECUTOR_EMAIL="executor@yourname.local"
DEV_EXECUTOR_PASSWORD="ChooseDevExecutorPass#1"

# Optional QA admin + executor pair (seeded together, used by
# scripts/verify-realtime.ts). Set all four or none.
QA_ADMIN_EMAIL="qa-admin@yourname.local"
QA_ADMIN_PASSWORD="ChooseQaAdminPass#1"
QA_EXECUTOR_EMAIL="qa-executor@yourname.local"
QA_EXECUTOR_PASSWORD="ChooseQaExecutorPass#1"

# Separate database used ONLY by automated backend tests (vitest)
FIS_TEST_DATABASE_URL=

# Development-only shadow database for prisma migrate dev
SHADOW_DATABASE_URL=

# Global rate limit: N requests per window
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Stricter rate limit for future /auth endpoints (brute-force protection)
AUTH_RATE_LIMIT_MAX=10

# Logging detail (info | debug | warn | error)
LOG_LEVEL=info
