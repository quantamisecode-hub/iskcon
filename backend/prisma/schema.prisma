// =============================================================================
// FOOD INVENTORY SYSTEM - Prisma schema (Phase 3)
// Core entities: User, Session, AdminExecutorAssignment, AuditLog (Phase 2)
// + Category, Unit, FoodItem, Inventory, InventoryTransaction (Phase 3)
//
// Conventions:
//  - IDs: UUID strings (generated at application layer by Prisma client)
//  - timestamps: maintained automatically
//  - passwords: only Argon2id HASHES are stored (never plaintext)
//  - session tokens: only SHA-256 hashes are stored (never raw tokens)
///

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  // Development-only shadow database for `prisma migrate dev`
  // (the app user has rights on this exact database only).
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

/// Application roles. Extensible in later phases without schema overhaul.
enum Role {
  ADMIN
  EXECUTOR
}

/// Application user. Historical references are preserved:
/// users are DEACTIVATED (isActive=false), never hard-deleted in Phase 2.
model User {
  id           String    @id @default(uuid()) @db.Char(36)
  firstName    String    @db.VarChar(100)
  lastName     String    @db.VarChar(100)
  email        String    @unique @db.VarChar(255)
  passwordHash String    @db.VarChar(255)
  role         Role
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  avatarUrl    String?   @db.MediumText
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions        Session[]
  auditLogs       AuditLog[]
  adminAssigns    AdminExecutorAssignment[] @relation("AdminAssignments")
  executorAssigns AdminExecutorAssignment[] @relation("ExecutorAssignments")
  eventsAsAdmin   Event[]  @relation("EventAdmin")
  eventsCreated   Event[]  @relation("EventCreator")
  notifications   Notification[]
  requestsRequested MaterialRequest[] @relation("RequestRequester")
  requestsAdmin     MaterialRequest[] @relation("RequestAdmin")
  requestsApproved  MaterialRequest[] @relation("RequestApprover")
  requestTimeline   MaterialRequestTimeline[]
  eventsCancelled   Event[] @relation("EventCanceller")
  returnsRequested  MaterialReturn[] @relation("ReturnRequester")
  returnsAdmin      MaterialReturn[] @relation("ReturnAdmin")
  returnTimeline    MaterialReturnTimeline[]

  @@index([role])
  @@index([isActive])
}

/// Authentication session (support for multiple devices).
/// SECURITY: `tokenHash` is a SHA-256 hash of the random session token.
/// The raw token NEVER touches the database or any API response.
model Session {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @db.Char(36)
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?   @db.VarChar(64)
  userAgent String?   @db.VarChar(255)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Admin -> Executor assignment, WITH full history:
/// ending an assignment marks isActive=false + unassignedAt (never deleted).
/// Rule "no duplicate ACTIVE assignment" is enforced atomically in the
/// assignment service using a row lock inside a transaction.
model AdminExecutorAssignment {
  id           String    @id @default(uuid()) @db.Char(36)
  adminId      String    @db.Char(36)
  executorId   String    @db.Char(36)
  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  admin    User   @relation("AdminAssignments", fields: [adminId], references: [id], onDelete: Restrict)
  executor User   @relation("ExecutorAssignments", fields: [executorId], references: [id], onDelete: Restrict)

  @@index([adminId, isActive])
  @@index([executorId, isActive])
  @@index([assignedAt])
}

/// Audit trail for security-relevant actions. Append-only.
/// NEVER stores: passwords, password hashes, raw tokens, secrets.
model AuditLog {
  id         String   @id @default(uuid()) @db.Char(36)
  /// Actor (null only for failed login attempts by unknown users).
  userId     String?  @db.Char(36)
  action     String   @db.VarChar(50)
  entityType String   @db.VarChar(50)
  entityId   String?  @db.VarChar(64)
  oldValues  Json?
  newValues  Json?
  ipAddress  String?  @db.VarChar(64)
  userAgent  String?  @db.VarChar(255)
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// =============================================================================
// PHASE 3: INVENTORY MASTER
// =============================================================================

/// Food category. Names are unique; inactive categories cannot be selected
/// for new Food Items but historical records remain valid.
model Category {
  id          String    @id @default(uuid()) @db.Char(36)
  name        String    @unique @db.VarChar(100)
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  foodItems FoodItem[]
}

/// Unit of measurement. Symbol must be unique; inactive units cannot be
/// selected for new Food Items but historical records remain valid.
model Unit {
  id          String    @id @default(uuid()) @db.Char(36)
  name        String    @unique @db.VarChar(50)
  symbol      String    @unique @db.VarChar(10) // e.g. KG, G, L, ML, PCS
  unitType    String    // WEIGHT, VOLUME, COUNT, OTHER
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  foodItems      FoodItem[]
  dishMaterials  DishMaterial[]
  eventMaterials EventMaterial[]
  requestItems   MaterialRequestItem[]
  returnItems    MaterialReturnItem[]
}

/// Food Item master. Every item has a unique name, a category, a unit,
/// minimum stock, and a reorder level.
model FoodItem {
  id               String    @id @default(uuid()) @db.Char(36)
  name             String    @unique @db.VarChar(200)
  description      String?
  categoryId       String    @db.Char(36)
  unitId           String    @db.Char(36)
  minimumStock     Int      // minimum stock threshold
  reorderLevel     Int      // reorder trigger level
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  category        Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  unit            Unit      @relation(fields: [unitId], references: [id], onDelete: Restrict)
  inventory          Inventory? // one inventory record per food item (optional during setup)
  inventoryTransactions InventoryTransaction[]
  dishMaterials      DishMaterial[]
  eventMaterials     EventMaterial[]
  requestItems       MaterialRequestItem[]
  returnItems        MaterialReturnItem[]
}

/// Current stock level for a food item. One inventory record per food item.
model Inventory {
  id            String    @id @default(uuid()) @db.Char(36)
  foodItemId    String    @unique @db.Char(36) // one-to-one with FoodItem
  currentQuantity Int      @default(0)
  updatedAt     DateTime  @updatedAt

  foodItem FoodItem @relation(fields: [foodItemId], references: [id], onDelete: Cascade)
}

/// Inventory Transaction ledger. Every balance change is recorded here.
model InventoryTransaction {
  id             String    @id @default(uuid()) @db.Char(36)
  foodItemId     String    @db.Char(36)
  /// Idempotency key — client-generated UUID per stock movement. Duplicate
  /// requests with the same key return the existing result instead of
  /// re-applying the movement. Globally unique (UUIDs make collisions
  /// practically impossible).
  idempotencyKey String?   @unique
  transactionType String    // STOCK_IN, STOCK_OUT, ADJUSTMENT, RETURN
  quantity       Int
  balanceBefore  Int
  balanceAfter   Int
  referenceType  String?   // e.g. STOCK_IN, STOCK_OUT, etc.
  referenceId    String?   // ID of the originating record
  performedBy    String?   // user ID who performed the action
  remarks        String?
  createdAt      DateTime  @default(now())

  foodItem FoodItem @relation(fields: [foodItemId], references: [id], onDelete: Cascade)

  @@index([foodItemId])
  @@index([transactionType])
  @@index([createdAt])
}

// =============================================================================
// PHASE 4: EVENTS + CALENDAR + DISH + MATERIAL PLANNING
// Planning ONLY - Event Materials NEVER deduct inventory stock.
// =============================================================================

/// Event lifecycle. DRAFT -> PLANNING -> READY -> COMPLETED.
/// DRAFT/PLANNING/READY may transition to CANCELLED. COMPLETED/CANCELLED are terminal.
enum EventStatus {
  DRAFT
  PLANNING
  READY
  COMPLETED
  CANCELLED
}

/// An event (e.g. a Mahaprasadam offering) planned against inventory.
/// eventCode (EVT-YYYY-NNNNNN) is for display only - never used as primary key.
model Event {
  id             String      @id @default(uuid()) @db.Char(36)
  eventCode      String      @unique @db.VarChar(30)
  name           String      @db.VarChar(200)
  description    String?     @db.Text
  eventDate      DateTime    @db.Date
  startTime      String      @db.VarChar(5) // "HH:MM" 24h, Asia/Kolkata wall time
  endTime        String?     @db.VarChar(5)
  numberOfPeople Int
  location       String?     @db.VarChar(200)
  notes          String?     @db.Text
  status         EventStatus @default(DRAFT)
  /// Cancellation context. Set by the cancellation lifecycle (Phase 7 extension);
  /// never null once status = CANCELLED through POST /events/:id/cancel.
  cancellationReason String? @db.Text
  cancelledAt        DateTime?
  cancelledById      String?  @db.Char(36)
  adminId        String      @db.Char(36)
  createdBy      String      @db.Char(36)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  admin   User        @relation("EventAdmin", fields: [adminId], references: [id], onDelete: Restrict)
  creator User        @relation("EventCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  cancelledBy User?   @relation("EventCanceller", fields: [cancelledById], references: [id], onDelete: SetNull)
  dishes  EventDish[]
  materialRequests MaterialRequest[]
  returns MaterialReturn[]

  @@index([adminId])
  @@index([createdBy])
  @@index([status])
  @@index([eventDate])
}

/// Atomic per-year counter guaranteeing unique event codes (EVT-YYYY-NNNNNN).
model EventCodeCounter {
  year       Int @id
  lastNumber Int @default(0)
}

/// Dish master. Names are unique; inactive dishes cannot be added to new
/// events but historical records remain valid.
model Dish {
  id          String    @id @default(uuid()) @db.Char(36)
  name        String    @unique @db.VarChar(200)
  description String?   @db.Text
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  materials DishMaterial[]
  events    EventDish[]
  requestItems MaterialRequestItem[]
}

/// Recipe/template mapping: one dish uses many food items.
/// quantityPerPerson is a TEMPLATE reference only - no automatic calculation in Phase 4.
model DishMaterial {
  id               String   @id @default(uuid()) @db.Char(36)
  dishId           String   @db.Char(36)
  foodItemId       String   @db.Char(36)
  quantityPerPerson Decimal? @db.Decimal(10, 3)
  unitId           String   @db.Char(36)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  dish     Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade)
  foodItem FoodItem @relation(fields: [foodItemId], references: [id], onDelete: Restrict)
  unit     Unit     @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@unique([dishId, foodItemId])
  @@index([dishId])
  @@index([foodItemId])
}

/// Dishes selected for an event. Inactive dishes cannot be added.
model EventDish {
  id           String   @id @default(uuid()) @db.Char(36)
  eventId      String   @db.Char(36)
  dishId       String   @db.Char(36)
  displayOrder Int      @default(0)
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  event     Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  dish      Dish            @relation(fields: [dishId], references: [id], onDelete: Restrict)
  materials EventMaterial[]

  @@unique([eventId, dishId])
  @@index([eventId])
}

/// Planned material requirement for an event dish.
/// PLANNING ONLY - creating/editing these rows NEVER deducts inventory stock.
/// isDraft: shortfall lines parked as drafts — committed by an ADMIN once stock is available.
model EventMaterial {
  id              String   @id @default(uuid()) @db.Char(36)
  eventDishId     String   @db.Char(36)
  foodItemId      String   @db.Char(36)
  plannedQuantity Decimal  @db.Decimal(12, 3)
  unitId          String   @db.Char(36)
  notes           String?  @db.Text
  isDraft         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  eventDish EventDish @relation(fields: [eventDishId], references: [id], onDelete: Cascade)
  foodItem  FoodItem  @relation(fields: [foodItemId], references: [id], onDelete: Restrict)
  unit      Unit      @relation(fields: [unitId], references: [id], onDelete: Restrict)
  requestItems MaterialRequestItem[]

  @@unique([eventDishId, foodItemId])
  @@index([eventDishId])
}

// =============================================================================
// PHASE 6/7: MATERIAL REQUESTS + APPROVAL + ACTUAL STOCK ISSUE
// DRAFT -> PENDING_APPROVAL -> APPROVED -> PARTIALLY_ISSUED -> ISSUED
// Branches: PENDING_APPROVAL -> REJECTED, DRAFT/PENDING_APPROVAL -> CANCELLED.
// Approval NEVER deducts stock. Only an actual ISSUE moves inventory.
// =============================================================================

enum MaterialRequestStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PARTIALLY_ISSUED
  ISSUED
  REJECTED
  CANCELLED
  /// Set by EVENT CANCELLATION: the event went away before this request was
  /// issued. Terminal. Never rewritten, never approved, never issued.
  CANCELLED_BY_EVENT
}

/// Item-level lifecycle. A multi-item request can be partially issued.
enum MaterialRequestItemStatus {
  REQUESTED
  APPROVED
  PARTIALLY_ISSUED
  ISSUED
  REJECTED
  CANCELLED
  CANCELLED_BY_EVENT
}

/// INITIAL = the first request raised for an event.
/// ADDITIONAL = a later, separately-numbered request for the same event that
/// links back to its parent. Additional requests NEVER mutate the original.
enum MaterialRequestType {
  INITIAL
  ADDITIONAL
}

/// Human-facing code: REQ-YYYY-NNNNNN (counter table, never a primary key).
model MaterialRequestCodeCounter {
  year       Int @id
  lastNumber Int @default(0)
}

/// Material issued out to an event against the event's material plan.
/// Stock is NEVER deducted at request time or approval time — Phase 7.
model MaterialRequest {
  id              String                @id @default(uuid()) @db.Char(36)
  requestCode     String                @unique @db.VarChar(30)
  eventId         String                @db.Char(36)
  requestedById   String                @db.Char(36)
  adminId         String                @db.Char(36) /// Derived at creation from the event, never trusted from the client
  status          MaterialRequestStatus @default(DRAFT)
  /// INITIAL (default) or ADDITIONAL. Additions are new rows — the original is never edited.
  requestType     MaterialRequestType   @default(INITIAL)
  /// For ADDITIONAL requests: the INITIAL request this one extends.
  /// Validated server-side: same event, same executor scope, no cycles.
  parentRequestId String?               @db.Char(36)
  /// Required reason text for ADDITIONAL requests (short quantity, extra guests, ...).
  reason          String?               @db.VarChar(500)
  notes           String?               @db.Text
  submittedAt     DateTime?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  issuedAt        DateTime?
  approverId      String?               @db.Char(36)
  rejectionReason String?               @db.Text
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  event       Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  requestedBy User                  @relation("RequestRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  admin       User                  @relation("RequestAdmin", fields: [adminId], references: [id], onDelete: Restrict)
  approver    User?                 @relation("RequestApprover", fields: [approverId], references: [id], onDelete: Restrict)
  parent      MaterialRequest?      @relation("RequestParent", fields: [parentRequestId], references: [id], onDelete: SetNull)
  children    MaterialRequest[]     @relation("RequestParent")
  items       MaterialRequestItem[]
  timeline    MaterialRequestTimeline[]

  @@index([eventId])
  @@index([requestedById])
  @@index([adminId])
  @@index([status])
  @@index([requestType])
  @@index([parentRequestId])
  @@index([createdAt])
}

/// One line of a material request — the executor's requested quantity against a
/// dish material. plannedQuantity keeps the original plan snapshot for audit.
model MaterialRequestItem {
  id                   String   @id @default(uuid()) @db.Char(36)
  requestId            String   @db.Char(36)
  foodItemId           String   @db.Char(36)
  dishId               String?  @db.Char(36)
  plannedQuantity      Decimal  @db.Decimal(12, 3) /// copied from the event plan at request creation
  requestedQuantity    Decimal  @default(0) @db.Decimal(12, 3)
  approvedQuantity     Decimal  @default(0) @db.Decimal(12, 3)
  issuedQuantity       Decimal  @default(0) @db.Decimal(12, 3)
  rejectedQuantity     Decimal  @default(0) @db.Decimal(12, 3)
  unitId               String   @db.Char(36)
  sourceEventMaterialId String? @db.Char(36)
  remarks              String?  @db.Text
  status               MaterialRequestItemStatus @default(REQUESTED)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  request   MaterialRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  foodItem  FoodItem        @relation(fields: [foodItemId], references: [id], onDelete: Restrict)
  unit      Unit            @relation(fields: [unitId], references: [id], onDelete: Restrict)
  dish      Dish?           @relation(fields: [dishId], references: [id], onDelete: SetNull)
  sourceMaterial EventMaterial? @relation(fields: [sourceEventMaterialId], references: [id], onDelete: SetNull)

  @@index([requestId])
  @@index([foodItemId])
  @@index([dishId])
}

/// Immutable, append-only user-facing journey for a request.
/// Entries are created only by the service; there is no update or delete API.
model MaterialRequestTimeline {
  id         String   @id @default(uuid()) @db.Char(36)
  requestId  String   @db.Char(36)
  actorId    String?  @db.Char(36)
  action     String   @db.VarChar(50)
  fromStatus String?  @db.VarChar(50)
  toStatus   String?  @db.VarChar(50)
  message    String   @db.Text
  metadata   Json?
  createdAt  DateTime @default(now())

  request MaterialRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor   User?           @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
  @@index([actorId])
}

/// Simple, append-once notification. `type` is a short machine key,
/// `reference*` points at the originating entity (e.g. MATERIAL_REQUEST / request.id).
/// `category` + `priority` implement the Phase 7 notification matrix (§49);
/// they default so every pre-existing row stays valid without a data migration.
model Notification {
  id            String   @id @default(uuid()) @db.Char(36)
  userId        String   @db.Char(36)
  type          String   @db.VarChar(50)
  /// Coarse grouping: EVENT, REQUEST, RETURN, INVENTORY, ACCOUNT, ...
  category      String   @default("GENERAL") @db.VarChar(30)
  /// NORMAL | HIGH | CRITICAL
  priority      String   @default("NORMAL") @db.VarChar(10)
  title         String   @db.VarChar(200)
  message       String   @db.Text
  referenceType String?  @db.VarChar(50)
  referenceId   String?  @db.Char(36)
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([type])
}

// =============================================================================
// PHASE 7 EXTENSION: EVENT CANCELLATION + MATERIAL RETURNS
//
// A MaterialReturn is the FOURTH distinct concept (never merged with
// Dish Material Definition / Material Request / Inventory Issue):
//   "what quantity physically came back".
// Inventory moves ONLY when an admin ACCEPTS a return — never on submit.
// =============================================================================

/// Return lifecycle. V1 persists PENDING_ADMIN_REVIEW / ACCEPTED /
/// PARTIALLY_ACCEPTED / REJECTED; the remaining values are reserved for the
/// draft-save and controlled-reopen workflows (documented, never faked).
enum MaterialReturnStatus {
  DRAFT
  SUBMITTED
  PENDING_ADMIN_REVIEW
  ACCEPTED
  PARTIALLY_ACCEPTED
  REJECTED
  COMPLETED
  CANCELLED
}

/// Human-facing code: RET-YYYY-NNNNNN (counter table, never a primary key).
model MaterialReturnCodeCounter {
  year       Int @id
  lastNumber Int @default(0)
}

/// A submitted return of physically-issued material back to inventory.
/// Scoped to the event + the executor who received the issue.
model MaterialReturn {
  id           String               @id @default(uuid()) @db.Char(36)
  returnCode   String               @unique @db.VarChar(30)
  eventId      String               @db.Char(36)
  requesterId  String               @db.Char(36)
  /// Derived at creation from the event — never trusted from the client.
  adminId      String               @db.Char(36)
  status       MaterialReturnStatus @default(PENDING_ADMIN_REVIEW)
  /// Optional picklist reason (EVENT_CANCELLED, EXTRA_MATERIAL, ...).
  reason       String?              @db.VarChar(50)
  /// Free-text note. Mandatory server-side when reason = OTHER.
  reasonNote   String?              @db.Text
  notes        String?              @db.Text
  requestedAt  DateTime             @default(now())
  reviewedAt   DateTime?
  completedAt  DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  event     Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  requester User                   @relation("ReturnRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  admin     User                   @relation("ReturnAdmin", fields: [adminId], references: [id], onDelete: Restrict)
  items     MaterialReturnItem[]
  timeline  MaterialReturnTimeline[]

  @@index([eventId])
  @@index([requesterId])
  @@index([adminId])
  @@index([status])
  @@index([createdAt])
}

/// One returned material line. `issuedQuantity` / `previouslyReturnedQuantity`
/// are POINT-IN-TIME SNAPSHOTS taken when the return was submitted, so the
/// admin screen can show what was on hand to return. The authoritative
/// returnable figure is always recomputed from issue + accepted-return history
/// inside the accepting transaction (over-return guard).
model MaterialReturnItem {
  id                       String   @id @default(uuid()) @db.Char(36)
  returnId                 String   @db.Char(36)
  foodItemId               String   @db.Char(36)
  unitId                   String   @db.Char(36)
  issuedQuantity           Decimal  @default(0) @db.Decimal(12, 3) /// snapshot at submit
  previouslyReturnedQuantity Decimal @default(0) @db.Decimal(12, 3) /// snapshot at submit
  requestedReturnQuantity  Decimal  @db.Decimal(12, 3)
  acceptedReturnQuantity   Decimal  @default(0) @db.Decimal(12, 3)
  rejectedReturnQuantity   Decimal  @default(0) @db.Decimal(12, 3)
  reason                   String?  @db.VarChar(50)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  return   MaterialReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  foodItem FoodItem       @relation(fields: [foodItemId], references: [id], onDelete: Restrict)
  unit     Unit           @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@index([returnId])
  @@index([foodItemId])
}

/// Immutable, append-only journey for a return. No update/delete API exists.
model MaterialReturnTimeline {
  id         String   @id @default(uuid()) @db.Char(36)
  returnId   String   @db.Char(36)
  actorId    String?  @db.Char(36)
  action     String   @db.VarChar(50)
  fromStatus String?  @db.VarChar(50)
  toStatus   String?  @db.VarChar(50)
  message    String   @db.Text
  metadata   Json?
  createdAt  DateTime @default(now())

  return MaterialReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  actor  User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([returnId, createdAt])
  @@index([actorId])
}

// =============================================================================
// END PHASE 6 MODELS
// =============================================================================