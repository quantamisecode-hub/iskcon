# =============================================================
# PRODUCTION ENVIRONMENT — COPY to ".env" on the VPS and fill in.
# NEVER commit the real .env. Keep secrets out of git.
# Backend loads this file automatically (dotenv).
# =============================================================

NODE_ENV=production
PORT=5000

# MySQL (local on the VPS). Use a dedicated DB + restricted user.
DATABASE_URL="mysql://iskcon_app:CHANGE_ME_STRONG_PASSWORD@localhost:3306/iskcon"

# Request body limit
REQUEST_BODY_LIMIT=100kb

# Allowed browser origin(s) for credential-bearing CORS.
# Production example (single frontend):
CORS_ORIGIN=https://YOUR_FRONTEND_DOMAIN
# Multiple origins are supported (comma-separated), e.g. production + preview:
# CORS_ORIGIN=https://app.example.com,https://staging.example.com

# Legacy alias still accepted. CORS_ORIGIN takes precedence when both exist.
# FRONTEND_URL=https://YOUR_FRONTEND_DOMAIN

# Session cookie — MUST be Secure (HTTPS) in production.
# Same-origin deployment (Nginx serves SPA + API): lax
# Cross-origin deployment (Vercel frontend + separate API): none
#   SameSite=None requires COOKIE_SECURE=true and HTTPS on both sides.
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
SESSION_COOKIE_NAME=fis_session
SESSION_EXPIRES_DAYS=7

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# Logging
LOG_LEVEL=info

# NOTE: do NOT deploy the development seed accounts. Create the first
# production admin with: npx tsx scripts/create-admin.ts admin@example.org "StrongPass#1"
