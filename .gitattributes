# Store text with LF in Git so Windows and macOS checkouts produce no
# line-ending-only diffs.
* text=auto eol=lf

# Windows-only scripts need CRLF to run correctly.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets — never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
