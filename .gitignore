# =============================================================
# FOOD INVENTORY SYSTEM - ROOT GITIGNORE
# Rules: everything secret or machine-generated stays out of Git.
# .env.example files ARE committed (they contain no real secrets).
# =============================================================

# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Environment files - NEVER commit real credentials.
# .env / .env.local hold machine-specific secrets and are ignored.
# frontend/.env.development / .env.production contain only PUBLIC
# VITE_* values (no secrets) and are intentionally committed.
.env
.env.local
.env.*.local

# Logs
logs/
*.log
npm-debug.log*

# Test coverage
coverage/

# Editor / operating system noise
.vscode/
.idea/
.DS_Store
Thumbs.db
