# =============================================================
# PRODUCTION BUILD (Vite `npm run build`)
#
# This is a PLACEHOLDER. On Vercel, set the real value in:
#   Project Settings -> Environment Variables -> VITE_API_URL
# and redeploy (Vite embeds the value at build time).
#
# Example real value:
#   https://api.your-real-domain.com/api/v1
#
# Public browser configuration only - never put secrets here.
# =============================================================
VITE_API_URL=https://api.YOUR_DOMAIN/api/v1

# Axios timeout in milliseconds
VITE_API_TIMEOUT_MS=15000
