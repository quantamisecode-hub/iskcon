# =============================================================
# FRONTEND - PUBLIC environment variables ONLY.
# Anything prefixed with VITE_ is bundled into the JavaScript the
# browser downloads, so it is effectively PUBLIC.
# NEVER put passwords, JWT secrets, or database credentials here.
# =============================================================
# Address of our Node.js backend API
VITE_API_BASE_URL=http://localhost:5000/api

# How long to wait (in milliseconds) before giving up on an API call
VITE_API_TIMEOUT_MS=15000
