# =============================================================
# FRONTEND - PUBLIC environment variables ONLY.
# Anything prefixed with VITE_ is bundled into the JavaScript the
# browser downloads, so it is effectively PUBLIC.
# NEVER put passwords, JWT secrets, database credentials, private
# API keys, or any other secret here.
#
# Copy this file to .env.development (local) or configure the
# values in your hosting platform (Vercel -> Environment Variables).
# =============================================================

# FULL backend API root INCLUDING the /api/v1 prefix.
# Local development:
#   VITE_API_URL=http://localhost:5000/api/v1
# Production (placeholder - replace with your real API origin):
#   VITE_API_URL=https://api.YOUR_DOMAIN/api/v1
#
# Changing this value requires a new frontend build/deployment:
# Vite embeds VITE_* values at build time.
VITE_API_URL=

# Axios timeout in milliseconds
VITE_API_TIMEOUT_MS=15000
